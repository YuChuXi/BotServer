# ==================== NoneBot 基础配置 ====================
PORT=47826
HOST="127.0.0.1"
LOG_LEVEL="INFO"
FASTAPI_RELOAD=true

# ==================== 认证配置 ====================
# WebSocket 连接令牌（用于服务器连接认证）
TOKEN="puep6too5in9oodei7SohB5ahrae7T"

# ==================== 权限配置 ====================
# 主机管理员（可以执行shell命令，包含所有权限）
HOST_ADMINS=[3509270136, 3619545924]

# MC服务端管理员（可以执行cmd命令，包含社区管理权限）
MC_SERVER_ADMINS=[2711974050,3174840292]

# 社区管理员（可以管理绑定、白名单、黑名单）
COMMUNITY_ADMINS=[]

# 是否将群管理员自动视为社区管理员
ENABLE_GROUP_ADMIN_AS_COMMUNITY_ADMIN=true

# ==================== 消息配置 ====================
# 主群（用于指令）
TARGET_QQ_GROUPS=[711159914]

# 双向同步聊天群（所有消息自动转发到所有服务器）
SYNC_QQ_GROUP=1049764220

# 是否启用游戏消息同步到QQ
ENABLE_GAME_TO_QQ_SYNC=true

# ==================== 聊天群事件转发配置 ====================
# 控制服务器事件是否转发到聊天群（sync_qq_group）
ENABLE_SYNC_GROUP_SERVER_STARTUP=true
ENABLE_SYNC_GROUP_SERVER_SHUTDOWN=true
ENABLE_SYNC_GROUP_PLAYER_JOINED=true
ENABLE_SYNC_GROUP_PLAYER_LEFT=true
ENABLE_SYNC_GROUP_PLAYER_CHAT=true
ENABLE_SYNC_GROUP_PLAYER_DEATH=true

# ==================== 服务器配置 ====================
# 机器人玩家前缀（用于识别机器人）
BOT_PLAYER_PREFIX=""

# ==================== 白名单配置 ====================
# 基岩版白名单命令
BEDROCK_WHITELIST_COMMAND="fwhitelist"

# Java版白名单命令
JAVA_WHITELIST_COMMAND="whitelist"

# 每个QQ最大绑定数量
MAX_BINDINGS_PER_QQ=1

# ==================== 消息颜色配置 ====================
# 消息颜色-来源
MESSAGE_COLOR_SOURCE="gray"

# 消息颜色-玩家
MESSAGE_COLOR_PLAYER="gray"

# 消息颜色-内容
MESSAGE_COLOR_CONTENT="gray"
