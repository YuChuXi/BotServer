# ==================== NoneBot 基础配置 ====================
PORT=47826
HOST="127.0.0.1"
LOG_LEVEL="INFO"
FASTAPI_RELOAD=true

# ==================== 认证配置 ====================
# WebSocket 连接令牌（用于服务器连接认证）
TOKEN="puep6too5in9oodei7SohB5ahrae7T"

# ==================== 权限配置 ====================
# 主机管理员（可以执行 #shell 命令，拥有最高权限）
HOST_ADMINS=[3509270136, 3619545924]

# MC服务端管理员（可以执行 #cmd 命令，拥有查服、管理等权限）
MC_SERVER_ADMINS=[2711974050, 3174840292]

# 社区管理员（可以管理绑定，拥有查服权限）
COMMUNITY_ADMINS=[]

# 是否将群管理员自动视为社区管理员
ENABLE_GROUP_ADMIN_AS_COMMUNITY_ADMIN=true

# ==================== 绑定与群组配置 ====================
# 默认目标QQ群
# 当新服务器连接且未在 Data/Server.json 配置时，会自动绑定到列表中的第一个群
TARGET_QQ_GROUPS=[711159914]

# 每个QQ最大绑定数量
MAX_BINDINGS_PER_QQ=1

# 机器人玩家前缀（用于识别机器人，不区分大小写）
BOT_PLAYER_PREFIX=""

# ==================== 消息样式配置 ====================
# 颜色支持: black, dark_blue, dark_green, dark_aqua, dark_red, dark_purple, gold, gray, 
#          dark_gray, blue, green, aqua, red, light_purple, yellow, white
MESSAGE_COLOR_SOURCE="gray"
MESSAGE_COLOR_PLAYER="gray"
MESSAGE_COLOR_CONTENT="gray"

# ==================== 注意事项 ====================
# 1. 具体的服务器同步配置（如是否转发聊天、白名单命令等）已移至 Data/Server.json
# 2. 已废弃配置：SYNC_QQ_GROUP, ENABLE_GAME_TO_QQ_SYNC, BEDROCK_WHITELIST_COMMAND 等
