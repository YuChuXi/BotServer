# ==================== NoneBot 基础配置 ====================
PORT=47826
HOST="0.0.0.0"
LOG_LEVEL="INFO"
FASTAPI_RELOAD=true

# ==================== 认证配置 ====================
# WebSocket 连接令牌（用于服务器连接认证），请自行生成足够长的随机字符串
TOKEN=""

# ==================== 权限配置 ====================
# 主机管理员 QQ 号（可以执行 #shell 命令，拥有最高权限）
HOST_ADMINS=[]

# MC 服务端管理员 QQ 号（可以执行 #cmd 命令，拥有查服、管理等权限）
MC_SERVER_ADMINS=[]

# 社区管理员 QQ 号（可以管理绑定，拥有查服权限）
COMMUNITY_ADMINS=[]

# 是否将群管理员自动视为社区管理员
ENABLE_GROUP_ADMIN_AS_COMMUNITY_ADMIN=true

# ==================== 绑定与群组配置 ====================
# 默认目标 QQ 群
# 当新服务器连接且未在 Data/Server.json 配置时，会自动绑定到列表中的第一个群
TARGET_QQ_GROUPS=[]

# 每个 QQ 最大绑定数量
MAX_BINDINGS_PER_QQ=1

# 机器人玩家前缀（用于识别机器人，不区分大小写）
BOT_PLAYER_PREFIX=""

# ==================== 消息样式配置 ====================
# 颜色支持: black, dark_blue, dark_green, dark_aqua, dark_red, dark_purple, gold, gray,
#          dark_gray, blue, green, aqua, red, light_purple, yellow, white
MESSAGE_COLOR_SOURCE="gray"
MESSAGE_COLOR_PLAYER="gray"
MESSAGE_COLOR_CONTENT="gray"

# ==================== 插件：主机资源监控（Plugins/ResourceMonitor.py）====================
# Bot 在线时按间隔检测本机 CPU、内存、磁盘，任一项仍超阈值则每轮私聊通知 HOST_ADMINS
RESOURCE_MONITOR_ENABLED=true
RESOURCE_MONITOR_INTERVAL_SECONDS=1800
RESOURCE_ALERT_CPU_PERCENT=90
RESOURCE_ALERT_MEMORY_PERCENT=90
RESOURCE_ALERT_DISK_PERCENT=90
# JSON 字符串列表（与 HOST_ADMINS 一样写在方括号里），例如 ["/","/home","/mnt/data"]；写 [] 则 Linux 为 ["/"]、Windows 为系统盘
RESOURCE_MONITOR_DISK_PATH=[]

# ==================== 插件：消息记录（nonebot-plugin-chatrecorder / orm）====================
# orm 默认 db 在 ./data/db.sqlite3，这里指定到 Data 目录
SQLALCHEMY_DATABASE_URL="sqlite+aiosqlite:///Data/db.sqlite3"

# ==================== 插件：AI 聊天（Plugins/AIChat.py）====================
# Ollama 服务器地址
AI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Ollama 模型名称
AI_OLLAMA_MODEL=""
# 系统提示词（留空则使用插件内置默认值）
AI_SYSTEM_PROMPT=""
# AnySearch API Key（留空时按匿名额度调用）
AI_ANYSEARCH_API_KEY=""
# 是否启用工具调用
AI_ENABLE_TOOLS=true
# 单次回复最多工具调用轮数
AI_MAX_TOOL_ROUNDS=5
# 单个工具请求超时秒数
AI_TOOL_TIMEOUT_SEC=15
# fetch_url 与工作区读取返回的最大字符数
AI_FETCH_MAX_CHARS=6000
# 注入提示词的长期记忆字符预算
AI_MEMORY_INJECT_MAX_CHARS=4000
# 群历史保留条数与上下文压缩阈值
AI_HISTORY_MAX_ITEMS=400
AI_CONTEXT_MAX_CHARS=12000
AI_COMPRESS_KEEP_LAST=120
# 下载群消息图片的超时秒数
AI_IMAGE_TIMEOUT_SEC=8
